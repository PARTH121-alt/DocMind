# ==========================================================================
# DocMind - environment configuration
# Copy to `.env` and edit. NEVER commit a filled-in .env.
# ==========================================================================

# ---------------------------- App -----------------------------------------
ENVIRONMENT=development
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------- Database ------------------------------------
# SQLite by default (zero setup). For production use PostgreSQL:
#   postgresql+asyncpg://docmind:password@localhost:5432/docmind
DATABASE_URL=sqlite+aiosqlite:///storage/docmind.db

# ---------------------------- Storage -------------------------------------
STORAGE_DIR=storage
UPLOAD_MAX_MB=100

# ---------------------------- Vector DB -----------------------------------
# faiss (local, default) | chroma | qdrant
VECTOR_DB=faiss
# Only used when VECTOR_DB=qdrant
QDRANT_URL=
QDRANT_API_KEY=

# ---------------------------- Hugging Face -------------------------------
# Optional. Required for OCR, hosted LLMs, and the evaluation datasets.
# Create a read token at https://huggingface.co/settings/tokens
# The token is read server-side only and is never sent to the frontend.
HF_TOKEN=
HF_ENDPOINT=https://router.huggingface.co/hf-inference

# ---------------------------- Backends -----------------------------------
# Generation: "local" (ONNX, no API key) or "hf_api" (needs HF_TOKEN)
GENERATION_BACKEND=local
EMBEDDING_BACKEND=local
RERANKER_BACKEND=local

# ---------------------------- Models -------------------------------------
# Generation models (used when GENERATION_BACKEND=hf_api)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_MODEL_FAST=Qwen/Qwen2.5-1.5B-Instruct
HF_MODEL_HIGH_QUALITY=Qwen/Qwen2.5-14B-Instruct

# Local ONNX generation model (used when GENERATION_BACKEND=local)
LOCAL_LLM_REPO=onnx-community/Qwen2.5-0.5B-Instruct
LOCAL_LLM_ONNX_FILE=onnx/model_q4.onnx
LOCAL_LLM_CONTEXT_LENGTH=4096

# Embedding models
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_EMBEDDING_MODEL_BASE=BAAI/bge-base-en-v1.5
HF_EMBEDDING_MODEL_LARGE=BAAI/bge-large-en-v1.5

# Auxiliary models
HF_RERANKER_MODEL=BAAI/bge-reranker-base
HF_SUMMARIZATION_MODEL=facebook/bart-large-cnn
HF_QA_MODEL=deepset/roberta-base-squad2
HF_OCR_MODEL=microsoft/trocr-base-printed

# ---------------------------- RAG ----------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=6
RERANK_TOP_N=6
# Cap on passages given to sub-1B local models (they are derailed by
# competing figures in neighbouring passages). Leave blank to disable.
SMALL_MODEL_TOP_K=1
MAX_CONTEXT_CHARS=12000
TEMPERATURE=0.2
TOP_P=0.9
MAX_NEW_TOKENS=700
# Cosine similarity below this means "no supporting context".
RELEVANCE_THRESHOLD=0.32

# ---------------------------- Closed models (ChatGPT / Claude / Gemini) ------
# Open-weight models come from HF_TOKEN above. ChatGPT, Claude and Gemini are
# NOT distributed on the Hugging Face hub, so each vendor needs its own key.
# A provider with no key still appears in the model picker, greyed out with the
# name of the variable it needs - nothing fails at request time.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
#
# The OpenAI adapter is OpenAI-compatible, so pointing OPENAI_BASE_URL at
# Groq, DeepSeek, Mistral, xAI, Together, OpenRouter or a local llama.cpp
# server reuses it for those too:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------- Structured entities (Wikidata) -------
# Wikimedia throttles unauthenticated clients, so requests are spaced
# out and cached in-process. Set the interval to 0 to disable throttling.
WIKIDATA_MIN_INTERVAL_MS=350
WIKIDATA_CACHE_TTL_S=3600
WIKIDATA_CACHE_MAX=512
WIKIDATA_TIMEOUT_S=20

# ---------------------------- Web search / live answers ----------------------
# Optional. With no key, web answers use Wikipedia + any URLs you paste.
# Add one to get real web search (news, weather, prices, live pages).
#   BRAVE_API_KEY:  https://brave.com/search/api/
#   TAVILY_API_KEY: https://tavily.com
#   SERPER_API_KEY: https://serper.dev
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_MAX_RESULTS=5
WEB_FETCH_TOP_N=3
MAX_WEB_CHARS=20000
# Allow answers that are NOT grounded in your documents (greetings, general
# knowledge). Every answer is labelled with its source either way.
ALLOW_GENERAL_ANSWERS=true
# Allow fetching user-supplied URLs into the knowledge base.
ALLOW_WEB_FETCH=true

# ---------------------------- Evaluation ---------------------------------
ENABLE_DATASETS=true
HF_EVAL_DATASET=squad
HF_EVAL_MAX_SAMPLES=20

# ---------------------------- Limits -------------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_DEMO=true
DEMO_ALLOW_REGISTRATION=true
